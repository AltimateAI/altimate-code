{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["src", "test"]
}
