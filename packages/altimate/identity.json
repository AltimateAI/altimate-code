{
  "app": "altimate-code",
  "hostPlugins": "./host.ts",
  "buildPlugin": "./script/build-plugin.ts",
  "displayName": "Altimate Code",
  "userAgent": "altimate-code",
  "envPrefixes": ["ALTIMATE_CLI_", "OPENCODE_"],
  "configBasenames": ["altimate-code", "opencode"],
  "servicePort": 57241,
  "serviceName": "altimate-code",
  "updater": {
    "releaseUrl": "https://altimate.ai/altimate-code/update/api/{channel}/{artifact}/{distribution}?current={current}",
    "package": "@altimateai/altimate-code",
    "installedPackagePattern": "^(?:@altimateai/)?altimate-code$",
    "policyFiles": ["config.json", "opencode.json", "opencode.jsonc", "altimate-code.json", "altimate-code.jsonc"],
    "installDirectory": ".altimate-code",
    "installBinary": "altimate-code",
    "installerUrl": null,
    "brew": null,
    "winget": null
  },
  "logo": {
    "left": [
      "                                ",
      "▄▀█ █   ▀█▀ █ █▀▄▀█ ▄▀█ ▀█▀ █▀▀",
      "█▀█ █▄▄  █  █ █ ▀ █ █▀█  █  ██▄",
      "                                "
    ],
    "right": ["                 ", "█▀▀ █▀█ █▀▄ █▀▀", "█▄▄ █▄█ █▄▀ ██▄", "                 "]
  },
  "narrowLogo": {
    "left": ["   ", "▄▀█", "█▀█", "   "],
    "right": ["   ", "▄▀█", "█▀█", "   "]
  },
  "title": {
    "home": "Altimate Code",
    "prefix": "Altimate Code"
  },
  "onboarding": {
    "lines": [
      "Connect your Altimate account to start.",
      "Paste your instance::api-key, or connect another provider such as Claude, GPT or Gemini."
    ],
    "connect": "Connect Altimate"
  }
}
