 }
+
+/// Analyze SQL for anti-pattern tags using polyglot-sql-tags.
+#[napi]
+pub fn analyze_tags(
+    sql: String,
+    dialect: String,
+    skip_tags: Option<Vec<String>>,
+) -> Result<serde_json::Value> {
+    let dialect_type = crate::convert::parse_polyglot_dialect(&dialect)?;
+    let config = altimate_core::tagger::AnalysisConfig {
+        skip_tags: skip_tags.unwrap_or_default(),
+    };
+    let result = altimate_core::tagger::analyze_tags(&sql, dialect_type, &config);
+    crate::convert::to_json(&result)
+}
