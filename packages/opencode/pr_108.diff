 /// Serialize any `Serialize` type to a `serde_json::Value` for NAPI auto-conversion.
 pub fn to_json<T: serde::Serialize>(val: &T) -> Result<serde_json::Value, Error> {
     serde_json::to_value(val).map_err(|e| Error::from_reason(format!("serialization error: {e}")))
