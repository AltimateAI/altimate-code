+import zodToJsonSchema from "zod-to-json-schema";
+import { getConnectionsInstance } from "../..";
+
+export class MySQLTools extends ToolsBase {
+  name = "mysql";
+  description = "Run SQL queries using MySQL client";
+  integrationId = "mysql";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  private async getClient(connection: Connection) {
+    let mysql2: typeof import("mysql2/promise");
+    try {
+      mysql2 = await import("mysql2/promise");
+    } catch {
+      throw new Error(
+        "mysql2 package is not installed. Install it with: npm install mysql2"
+      );
+    }
+
+    const mysqlConfig = {
+      host: connection.config.mysqlHost as string,
+      port: parseInt(connection.config.mysqlPort as string) || 3306,
+      database: connection.config.mysqlDatabase as string,
+      user: connection.config.mysqlUsername as string,
+      password: connection.config.mysqlPassword as string,
+    };
+
+    return mysql2.createConnection(mysqlConfig);
+  }
+
+  async getTools(): Promise<RegisteredTool[]> {
+    return [
+      {
+        name: "mysql_execute_database_query",
+        description: "Execute SQL queries against a MySQL database",
+        inputSchema: zodToJsonSchema(
+          z.object({
+            connection_id: z.string().min(1, "Connection ID is required"),
+            sql_query: z.string().min(1, "SQL query is required"),
+          })
+        ) as ToolInput,
+        handler: async (args: Record<string, unknown>) => {
+          const connectionId = args.connection_id as string;
+          const sqlQuery = args.sql_query as string;
+
+          const connections = await getConnectionsInstance().getConnections();
+          const connection = connections.find(conn => conn.id === connectionId);
+
+          if (!connection) {
+            throw new Error(`Connection with ID ${connectionId} not found`);
+          }
+
+          const client = await this.getClient(connection);
+
+          try {
+            const [rows] = await client.execute(sqlQuery);
+            await client.end();
+
+            return {
+              content: [
+                {
+                  type: "text",
+                  text: JSON.stringify(rows, null, 2),
+                },
+              ],
+            };
+          } catch (error) {
+            await client.end();
+            throw error;
+          }
+        },
+      },
+      {
+        name: "mysql_list_database_connections",
+        description:
+          "List all available MySQL connections, call this tool before executing queries to get the connection ID",
+        inputSchema: zodToJsonSchema(z.object({})) as ToolInput,
+        handler: async () => {
+          const connections = await getConnectionsInstance().getConnections();
+          const mysqlConnections = connections.filter(
+            conn => conn.integration_id === this.integrationId
+          );
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(
+                  mysqlConnections.map(conn => ({
+                    id: conn.id,
+                    name: conn.name,
+                    integration_id: conn.integration_id,
+                  })),
+                  null,
+                  2
+                ),
+              },
+            ],
+          };
+        },
+      },
+    ];
+  }
+
+  async validateConnection(
+    connection: Connection
+  ): Promise<{ isValid: boolean; message?: string }> {
+    try {
+      const client = await this.getClient(connection);
