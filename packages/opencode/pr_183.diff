+import { getConnectionsInstance } from "../..";
+
+export class OracleTools extends ToolsBase {
+  name = "oracle";
+  description = "Run SQL queries using Oracle Database client (thin mode)";
+  integrationId = "oracle";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  private async executeWithConnection(
+    connection: Connection,
+    sqlQuery: string
+  ): Promise<Record<string, unknown>[]> {
+    let oracledb: typeof import("oracledb");
+    try {
+      oracledb = await import("oracledb");
+    } catch {
+      throw new Error(
+        "oracledb package is not installed. Install it with: npm install oracledb"
+      );
+    }
+
+    const host = connection.config.oracleHost as string;
+    const port = parseInt(connection.config.oraclePort as string) || 1521;
+    const serviceName = connection.config.oracleServiceName as string;
+
+    const connectString = `${host}:${port}/${serviceName}`;
+
+    const conn = await oracledb.default.getConnection({
+      user: connection.config.oracleUsername as string,
+      password: connection.config.oraclePassword as string,
+      connectString,
+    });
+
+    try {
+      const result = await conn.execute(sqlQuery, [], {
+        outFormat: oracledb.default.OUT_FORMAT_OBJECT,
+      });
+      await conn.close();
+      return (result.rows as Record<string, unknown>[]) || [];
+    } catch (error) {
