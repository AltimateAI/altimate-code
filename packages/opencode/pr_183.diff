diff --git a/src/tools/duckdb/index.ts b/src/tools/duckdb/index.ts
new file mode 100644
index 0000000..d474764
--- /dev/null
+++ b/src/tools/duckdb/index.ts
@@ -0,0 +1,141 @@
+import { ToolsBase } from "../toolsBase";
+import { Connection, RegisteredTool, ToolInput } from "../../server/types";
+import { z } from "zod";
+import zodToJsonSchema from "zod-to-json-schema";
+import { getConnectionsInstance } from "../..";
+
+export class DuckDBTools extends ToolsBase {
+  name = "duckdb";
+  description = "Run SQL queries using DuckDB embedded database";
+  integrationId = "duckdb";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  private async executeWithConnection(
+    connection: Connection,
+    sqlQuery: string
+  ): Promise<Record<string, unknown>[]> {
+    let duckdb: typeof import("duckdb");
+    try {
+      duckdb = await import("duckdb");
+    } catch {
+      throw new Error(
+        "duckdb package is not installed. Install it with: npm install duckdb"
+      );
+    }
+
+    const dbPath = (connection.config.duckdbPath as string) || ":memory:";
+
+    return new Promise((resolve, reject) => {
+      const db = new duckdb.default.Database(dbPath, (err) => {
+        if (err) {
+          reject(new Error(`Failed to open DuckDB database: ${err.message}`));
+          return;
+        }
+
+        const conn = db.connect();
+        conn.all(sqlQuery, (queryErr, rows) => {
+          if (queryErr) {
+            db.close(() => {});
+            reject(queryErr);
+            return;
+          }
+
+          db.close((closeErr) => {
+            if (closeErr) {
+              reject(closeErr);
+              return;
+            }
+            resolve((rows as Record<string, unknown>[]) || []);
+          });
+        });
+      });
+    });
+  }
+
+  async getTools(): Promise<RegisteredTool[]> {
+    return [
+      {
+        name: "duckdb_execute_database_query",
+        description: "Execute SQL queries against a DuckDB database",
+        inputSchema: zodToJsonSchema(
+          z.object({
+            connection_id: z.string().min(1, "Connection ID is required"),
+            sql_query: z.string().min(1, "SQL query is required"),
+          })
+        ) as ToolInput,
+        handler: async (args: Record<string, unknown>) => {
+          const connectionId = args.connection_id as string;
+          const sqlQuery = args.sql_query as string;
+
+          const connections = await getConnectionsInstance().getConnections();
+          const connection = connections.find(conn => conn.id === connectionId);
+
+          if (!connection) {
+            throw new Error(`Connection with ID ${connectionId} not found`);
+          }
+
+          const rows = await this.executeWithConnection(connection, sqlQuery);
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(rows, null, 2),
+              },
+            ],
+          };
+        },
+      },
+      {
+        name: "duckdb_list_database_connections",
+        description:
+          "List all available DuckDB connections, call this tool before executing queries to get the connection ID",
+        inputSchema: zodToJsonSchema(z.object({})) as ToolInput,
+        handler: async () => {
+          const connections = await getConnectionsInstance().getConnections();
+          const duckdbConnections = connections.filter(
+            conn => conn.integration_id === this.integrationId
+          );
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(
+                  duckdbConnections.map(conn => ({
+                    id: conn.id,
+                    name: conn.name,
+                    integration_id: conn.integration_id,
+                  })),
+                  null,
+                  2
+                ),
+              },
+            ],
+          };
+        },
+      },
+    ];
+  }
+
+  async validateConnection(
+    connection: Connection
+  ): Promise<{ isValid: boolean; message?: string }> {
+    try {
+      await this.executeWithConnection(connection, "SELECT 1 AS test");
+
+      return {
+        isValid: true,
+        message: "DuckDB connection validated successfully",
+      };
+    } catch (error) {
+      return {
+        isValid: false,
+        message: `Failed to validate DuckDB connection: ${error instanceof Error ? error.message : String(error)}`,
+      };
+    }
+  }
+}
