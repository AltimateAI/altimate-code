+import { ToolsBase } from "../toolsBase";
+import { Connection, RegisteredTool, ToolInput } from "../../server/types";
+import { z } from "zod";
+import zodToJsonSchema from "zod-to-json-schema";
+import { getConnectionsInstance } from "../..";
+
+export class SQLiteTools extends ToolsBase {
+  name = "sqlite";
+  description = "Run SQL queries using SQLite embedded database";
+  integrationId = "sqlite";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  private async executeWithConnection(
+    connection: Connection,
+    sqlQuery: string
+  ): Promise<Record<string, unknown>[]> {
+    let betterSqlite3: typeof import("better-sqlite3");
+    try {
+      betterSqlite3 = await import("better-sqlite3");
+    } catch {
+      throw new Error(
+        "better-sqlite3 package is not installed. Install it with: npm install better-sqlite3"
+      );
+    }
+
+    const dbPath = connection.config.sqlitePath as string;
+    if (!dbPath) {
+      throw new Error("SQLite database path (sqlitePath) is required");
+    }
+
+    const db = betterSqlite3.default(dbPath);
+
+    try {
+      // Determine if the query is a SELECT/read query or a write query
+      const trimmedQuery = sqlQuery.trim().toUpperCase();
+      const isReadQuery =
+        trimmedQuery.startsWith("SELECT") ||
+        trimmedQuery.startsWith("PRAGMA") ||
+        trimmedQuery.startsWith("EXPLAIN") ||
+        trimmedQuery.startsWith("WITH");
+
+      let rows: Record<string, unknown>[];
+      if (isReadQuery) {
+        rows = db.prepare(sqlQuery).all() as Record<string, unknown>[];
+      } else {
+        const result = db.prepare(sqlQuery).run();
+        rows = [{ changes: result.changes, lastInsertRowid: result.lastInsertRowid }];
+      }
+
+      db.close();
+      return rows;
+    } catch (error) {
+      db.close();
+      throw error;
+    }
+  }
+
+  async getTools(): Promise<RegisteredTool[]> {
+    return [
+      {
+        name: "sqlite_execute_database_query",
+        description: "Execute SQL queries against a SQLite database",
+        inputSchema: zodToJsonSchema(
+          z.object({
+            connection_id: z.string().min(1, "Connection ID is required"),
+            sql_query: z.string().min(1, "SQL query is required"),
+          })
+        ) as ToolInput,
+        handler: async (args: Record<string, unknown>) => {
+          const connectionId = args.connection_id as string;
+          const sqlQuery = args.sql_query as string;
+
+          const connections = await getConnectionsInstance().getConnections();
+          const connection = connections.find(conn => conn.id === connectionId);
+
+          if (!connection) {
+            throw new Error(`Connection with ID ${connectionId} not found`);
+          }
+
+          const rows = await this.executeWithConnection(connection, sqlQuery);
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(rows, null, 2),
+              },
+            ],
+          };
+        },
+      },
+      {
+        name: "sqlite_list_database_connections",
+        description:
+          "List all available SQLite connections, call this tool before executing queries to get the connection ID",
+        inputSchema: zodToJsonSchema(z.object({})) as ToolInput,
+        handler: async () => {
+          const connections = await getConnectionsInstance().getConnections();
+          const sqliteConnections = connections.filter(
+            conn => conn.integration_id === this.integrationId
+          );
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(
+                  sqliteConnections.map(conn => ({
+                    id: conn.id,
+                    name: conn.name,
+                    integration_id: conn.integration_id,
+                  })),
+                  null,
+                  2
+                ),
+              },
+            ],
+          };
+        },
+      },
+    ];
+  }
+
+  async validateConnection(
+    connection: Connection
+  ): Promise<{ isValid: boolean; message?: string }> {
+    try {
+      await this.executeWithConnection(connection, "SELECT 1 AS test");
+
+      return {
+        isValid: true,
+        message: "SQLite connection validated successfully",
+      };
+    } catch (error) {
+      return {
+        isValid: false,
+        message: `Failed to validate SQLite connection: ${error instanceof Error ? error.message : String(error)}`,
+      };
+    }
+  }
+}
