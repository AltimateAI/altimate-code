+import { ToolsBase } from "../toolsBase";
+import { Connection, RegisteredTool, ToolInput } from "../../server/types";
+import { Client } from "pg";
+import { z } from "zod";
+import zodToJsonSchema from "zod-to-json-schema";
+import { getConnectionsInstance } from "../..";
+
+export class RedshiftTools extends ToolsBase {
+  name = "redshift";
+  description = "Run SQL queries using Amazon Redshift (PostgreSQL wire-compatible)";
+  integrationId = "redshift";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  async getTools(): Promise<RegisteredTool[]> {
+    return [
+      {
+        name: "redshift_execute_database_query",
+        description: "Execute SQL queries against an Amazon Redshift database",
+        inputSchema: zodToJsonSchema(
+          z.object({
+            connection_id: z.string().min(1, "Connection ID is required"),
+            sql_query: z.string().min(1, "SQL query is required"),
+          })
+        ) as ToolInput,
+        handler: async (args: Record<string, unknown>) => {
+          const connectionId = args.connection_id as string;
+          const sqlQuery = args.sql_query as string;
+
+          const connections = await getConnectionsInstance().getConnections();
+          const connection = connections.find(conn => conn.id === connectionId);
+
+          if (!connection) {
+            throw new Error(`Connection with ID ${connectionId} not found`);
+          }
+
+          const pgConfig = {
+            host: connection.config.redshiftHost as string,
+            port: parseInt(connection.config.redshiftPort as string) || 5439,
+            database: connection.config.redshiftDatabase as string,
+            user: connection.config.redshiftUsername as string,
+            password: connection.config.redshiftPassword as string,
+            ssl: { rejectUnauthorized: false },
+          };
+
+          const client = new Client(pgConfig);
+
+          try {
+            await client.connect();
+
+            if (connection.config.redshiftSchema) {
+              await client.query(`SET search_path TO '${connection.config.redshiftSchema}'`);
+            }
+
+            const result = await client.query(sqlQuery);
+            await client.end();
+
+            return {
+              content: [
+                {
+                  type: "text",
+                  text: JSON.stringify(result.rows, null, 2),
+                },
+              ],
+            };
+          } catch (error) {
+            await client.end();
+            throw error;
+          }
+        },
+      },
+      {
+        name: "redshift_list_database_connections",
+        description:
+          "List all available Redshift connections, call this tool before executing queries to get the connection ID",
+        inputSchema: zodToJsonSchema(z.object({})) as ToolInput,
+        handler: async () => {
+          const connections = await getConnectionsInstance().getConnections();
+          const redshiftConnections = connections.filter(
+            conn => conn.integration_id === this.integrationId
+          );
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(
+                  redshiftConnections.map(conn => ({
+                    id: conn.id,
+                    name: conn.name,
+                    integration_id: conn.integration_id,
+                  })),
+                  null,
+                  2
+                ),
+              },
+            ],
+          };
+        },
+      },
+    ];
+  }
+
+  async validateConnection(
+    connection: Connection
+  ): Promise<{ isValid: boolean; message?: string }> {
+    const pgConfig = {
+      host: connection.config.redshiftHost as string,
+      port: parseInt(connection.config.redshiftPort as string) || 5439,
+      database: connection.config.redshiftDatabase as string,
+      user: connection.config.redshiftUsername as string,
+      password: connection.config.redshiftPassword as string,
+      ssl: { rejectUnauthorized: false },
+    };
+
+    const client = new Client(pgConfig);
+
+    try {
+      await client.connect();
+      await client.query("SELECT 1");
+      await client.end();
+
+      return {
+        isValid: true,
+        message: "Redshift connection validated successfully",
+      };
+    } catch (error) {
+      try {
+        await client.end();
+      } catch {
+        // Ignore cleanup errors
+      }
+      return {
+        isValid: false,
+        message: `Failed to validate Redshift connection: ${error instanceof Error ? error.message : String(error)}`,
+      };
+    }
+  }
+}
