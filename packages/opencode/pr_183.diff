+import { ToolsBase } from "../toolsBase";
+import { Connection, RegisteredTool, ToolInput } from "../../server/types";
+import { z } from "zod";
+import zodToJsonSchema from "zod-to-json-schema";
+import { getConnectionsInstance } from "../..";
+
+export class SQLServerTools extends ToolsBase {
+  name = "sqlserver";
+  description = "Run SQL queries using Microsoft SQL Server client";
+  integrationId = "sqlserver";
+
+  requiresConnectionSelection() {
+    return false;
+  }
+
+  private async executeWithConnection(
+    connection: Connection,
+    sqlQuery: string
+  ): Promise<Record<string, unknown>[]> {
+    let mssql: typeof import("mssql");
+    try {
+      mssql = await import("mssql");
+    } catch {
+      throw new Error(
+        "mssql package is not installed. Install it with: npm install mssql"
+      );
+    }
+
+    const config: import("mssql").config = {
+      server: connection.config.sqlserverHost as string,
+      port: parseInt(connection.config.sqlserverPort as string) || 1433,
+      database: connection.config.sqlserverDatabase as string,
+      user: connection.config.sqlserverUsername as string,
+      password: connection.config.sqlserverPassword as string,
+      options: {
+        encrypt: true,
+        trustServerCertificate: true,
+      },
+    };
+
+    const pool = await mssql.default.connect(config);
+
+    try {
+      const result = await pool.request().query(sqlQuery);
+      await pool.close();
+      return result.recordset;
+    } catch (error) {
+      await pool.close();
+      throw error;
+    }
+  }
+
+  async getTools(): Promise<RegisteredTool[]> {
+    return [
+      {
+        name: "sqlserver_execute_database_query",
+        description: "Execute SQL queries against a Microsoft SQL Server database",
+        inputSchema: zodToJsonSchema(
+          z.object({
+            connection_id: z.string().min(1, "Connection ID is required"),
+            sql_query: z.string().min(1, "SQL query is required"),
+          })
+        ) as ToolInput,
+        handler: async (args: Record<string, unknown>) => {
+          const connectionId = args.connection_id as string;
+          const sqlQuery = args.sql_query as string;
+
+          const connections = await getConnectionsInstance().getConnections();
+          const connection = connections.find(conn => conn.id === connectionId);
+
+          if (!connection) {
+            throw new Error(`Connection with ID ${connectionId} not found`);
+          }
+
+          const rows = await this.executeWithConnection(connection, sqlQuery);
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(rows, null, 2),
+              },
+            ],
+          };
+        },
+      },
+      {
+        name: "sqlserver_list_database_connections",
+        description:
+          "List all available SQL Server connections, call this tool before executing queries to get the connection ID",
+        inputSchema: zodToJsonSchema(z.object({})) as ToolInput,
+        handler: async () => {
+          const connections = await getConnectionsInstance().getConnections();
+          const sqlserverConnections = connections.filter(
+            conn => conn.integration_id === this.integrationId
+          );
+
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(
+                  sqlserverConnections.map(conn => ({
+                    id: conn.id,
+                    name: conn.name,
+                    integration_id: conn.integration_id,
+                  })),
+                  null,
+                  2
+                ),
+              },
+            ],
+          };
+        },
+      },
+    ];
+  }
+
+  async validateConnection(
+    connection: Connection
+  ): Promise<{ isValid: boolean; message?: string }> {
+    try {
+      await this.executeWithConnection(connection, "SELECT 1 AS test");
+
+      return {
+        isValid: true,
+        message: "SQL Server connection validated successfully",
+      };
+    } catch (error) {
+      return {
+        isValid: false,
+        message: `Failed to validate SQL Server connection: ${error instanceof Error ? error.message : String(error)}`,
+      };
+    }
+  }
+}
